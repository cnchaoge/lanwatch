{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lanwatch",
  "version": "0.1.0",
  "identifier": "cn.lanwatch.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lanwatch",
        "width": 440,
        "height": 940,
        "minWidth": 380,
        "minHeight": 760,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f3efe4"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/wifi-helper"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
